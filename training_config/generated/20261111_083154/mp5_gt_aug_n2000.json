{
  "model": {
    "type": "transformer",
    "message_passing_num": 5,
    "node_input_size": 3,
    "edge_input_size": 0,
    "output_size": 3,
    "hidden_size": 128,
    "num_heads": 4,
    "only_processor": false,
    "use_silu_activation": false,
    "use_gated_attention": true,
    "use_rope_embeddings": true,
    "rope_pos_dimension": 2,
    "rope_base": 10000,
    "dropout": 0.1,
    "adjacency_augmentation": {
      "enabled": true,
      "random_edges_ratio": 0.2,
      "dilation": {
        "enabled": true,
        "hop": 2,
        "start_layer": 2,
        "head_fraction": 0.5
      },
      "global_attention": {
        "enabled": true,
        "node_types": [
          "OBSTACLE"
        ],
        "sample_ratio": 0.01
      }
    }
  },
  "index": {
    "node_type_index": 3,
    "feature_index_start": 0,
    "feature_index_end": 3,
    "output_index_start": 0,
    "output_index_end": 3
  },
  "dataset": {
    "extension": "xdmf",
    "train_path": "data/data_xdmf/mesh_re100/n=2000/train",
    "val_path": "data/data_xdmf/mesh_re100/n=2000/valid",
    "test_path": "data/data_xdmf/mesh_re100/n=2000/test",
    "meta_path": "dataset_config/meta.json",
    "train_meta_path": "dataset_config/meta_train.json",
    "val_meta_path": "dataset_config/meta_val.json",
    "test_meta_path": "dataset_config/meta_test.json",
    "targets": [
      "velocity",
      "pressure"
    ],
    "khop": 1,
    "new_edges_ratio": 0.0
  },
  "training": {
    "enable_vram_optimizations": true,
    "early_stopping": {
      "enabled": false,
      "patience": 100,
      "min_delta": 0.0
    },
    "multi_step_loss": false,
    "multi_step_loss_steps": 3,
    "multi_step_loss_weight": 0.5,
    "scheduled_sampling": {
      "enabled": false,
      "start_probability": 0.0,
      "end_probability": 0.5,
      "start_epoch": 0,
      "end_epoch": 20
    },
    "use_temporal_block": true,
    "use_spatial_mtp": false,
    "spatial_mtp_alpha": 0.2,
    "spatial_mtp_centers_per_step": 256,
    "spatial_mtp_num_heads": 4,
    "spatial_mtp_num_layers": 1,
    "spatial_mtp_assume_undirected": true,
    "spatial_mtp_max_neighbors": 32
  },
  "loss": {
    "type": [
      "l2loss"
    ],
    "weights": [
      1.0
    ],
    "gradient_method": "least_squares"
  },
  "transformations": {
    "preprocessing": {
      "noise": [
        0.02,
        0.02
      ],
      "noise_index_start": [
        0,
        2
      ],
      "noise_index_end": [
        2,
        3
      ]
    },
    "world_pos_parameters": {
      "use": false,
      "world_pos_index_start": 0,
      "world_pos_index_end": 3,
      "radius": 0.03
    }
  },
  "compress_predictions": true
}
