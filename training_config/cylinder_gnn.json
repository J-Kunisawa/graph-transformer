{
  "model": {
    "type": "epd",
    "message_passing_num": 10,
    "node_input_size": 3,
    "edge_input_size": 3,
    "output_size": 3,
    "hidden_size": 64,
    "only_processor": false,
    "use_silu_activation": false,
    "use_gated_mlp": false,
    "use_gated_attention": false,
    "use_rope_embeddings": true,
    "rope_pos_dimension": 2,
    "rope_base": 10000,
    "dropout": 0.1
  },

  "index": {
    "node_type_index": 3,
    "feature_index_start": 0,
    "feature_index_end": 3,
    "output_index_start": 0,
    "output_index_end": 3
  },

  "dataset": {
    "extension": "h5",
    "train_path": "data/cylinder/train.h5",
    "val_path": "data/cylinder/valid.h5",
    "test_path": "data/cylinder/test.h5",
    "meta_path": "dataset_config/cylinder_meta.json",
    "targets": ["velocity", "pressure"],
    "khop": 1,
    "new_edges_ratio": 0.0
  },
  
  "training": {
    "enable_vram_optimizations": true,
    "use_temporal_block": false,
    "use_spatial_mtp": false,
    "spatial_mtp_alpha": 0.20,
    "spatial_mtp_centers_per_step": 256,
    "spatial_mtp_num_heads": 4,
    "spatial_mtp_num_layers": 1,
    "spatial_mtp_assume_undirected": true,
    "spatial_mtp_max_neighbors": 32,
    "min_lr_factor": 0.001
  },

  "loss": {
    "type": ["l2loss"],
    "weights": [1.0],
    "gradient_method": "least_squares"
  },

  "transformations": {
    "preprocessing": {
      "noise": [0.02, 0.001],
      "noise_index_start": [0, 2],
      "noise_index_end": [2, 3]
    },
    "world_pos_parameters": {
      "use": false,
      "world_pos_index_start": 0,
      "world_pos_index_end": 3
    }
  },
  "compress_predictions": true
}