{
  "model": {
    "type": "epd",
    "message_passing_num": 5,
    "node_input_size": 7,
    "edge_input_size": 4,
    "edge_feature": true,
    "output_size": 3,
    "hidden_size": 32,
    "dropout_rate": 0.1,
    "use_previous_data": true,
    "use_silu_activation": false,
    "use_gated_mlp": false
  },

  "index": {
    "feature_index_start": 0,
    "feature_index_end": 7,
    "output_index_start": 0,
    "output_index_end": 3,
    "node_type_index": 3,
    "previous_data_start": 5,
    "previous_data_end": 7
  },

  "dataset": {
    "extension": "h5",
    "train_path": "data/openfoam/100_datas/n=5000/re_0-1000/train.h5",
    "valid_path": "data/openfoam/100_datas/n=5000/re_0-1000/valid.h5",
    "test_path": "data/openfoam/10_datas/n=5000/re_200/test.h5",
    "meta_path": "dataset_config/openfoam_meta.json",
    "targets": ["velocity", "pressure"],
    "khop": 1
  },

  "transformations": {
    "preprocessing": {
        "noise": [0.05],
        "noise_index_start": [0],
        "noise_index_end": [3]
    }
  },

  "trainer": {
    "accelerator": "auto",
    "devices": 1,
    "gradient_clip_val": 1.0,
    "check_val_every_n_epoch": 1,
    "log_every_n_steps": 50,
    "enable_progress_bar": false,
    "enable_model_summary": true
  },

  "training": {
    "multi_step_loss": true,
    "multi_step_loss_steps": 5,
    "multi_step_loss_weight": 0.3
  },

  "optimizer": {
    "type": "adamw",
    "lr": 1e-4,
    "weight_decay": 1e-3,
    "betas": [0.9, 0.95]
  },

  "loss": {
    "type": ["l2loss"]
  },

  "early_stopping": {
    "monitor": "val_loss",
    "min_delta": 0.001,
    "patience": 10,
    "mode": "min"
  }
}